        <mxCell id="subtitle" value="Every paper answer follows one evidence path, from anchored source text to a cited response." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Inter;fontSize=14;fontColor=#475569;strokeColor=none;fillColor=none;" vertex="1" parent="1">
