        <mxCell id="ask" value="&lt;b&gt;1  Ask a question&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;Streamlit UI or CLI&lt;br&gt;Standard / Easy mode&lt;/font&gt;" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#93c5fd;strokeWidth=1.5;fontFamily=Inter;fontSize=14;align=left;spacingLeft=14;shadow=1;" vertex="1" parent="lane-live">
          <mxGeometry x="40" y="85" width="180" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="router" value="&lt;b&gt;2  Route request&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;LangGraph resolves intent&lt;br&gt;and follow-up context&lt;/font&gt;" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#93c5fd;strokeWidth=1.5;fontFamily=Inter;fontSize=14;align=left;spacingLeft=14;shadow=1;" vertex="1" parent="lane-live">
