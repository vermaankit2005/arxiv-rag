# Copy this file to .env and fill in the blanks. .env is gitignored.

# Ollama server and its Cloudflare Access service-token credentials.
OLLAMA_BASE_URL=
CF-ACCESS-CLIENT-ID=
CF-ACCESS-CLIENT-SECRET=

# Ollama chat model names. Use tags such as gemma4:26b.
GENERATOR_MODEL=
JUDGE_MODEL=

# Optional Groq fallback chat model. For GPT-OSS 120B, use openai/gpt-oss-120b.
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=
GROQ_API_KEY=

# LangSmith tracing. Leave LANGSMITH_TRACING=false to turn tracing off.
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
