# Copy this file to .env and fill in the blanks. .env is gitignored.

# Ollama server and its Cloudflare Access service-token credentials.
OLLAMA_BASE_URL=
CF-ACCESS-CLIENT-ID=
CF-ACCESS-CLIENT-SECRET=

# Ollama chat model names. Use tags such as gemma4:26b.
GENERATOR_MODEL=
JUDGE_MODEL=

# LangSmith tracing. Leave LANGSMITH_TRACING=false to turn tracing off.
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
