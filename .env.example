# Copy this file to .env and fill in the blanks. .env is gitignored.
# Cloudflare Access token for the ChatOpenAI-compatible vLLM endpoint.
CF-ACCESS-CLIENT-ID=
CF-ACCESS-CLIENT-SECRET=

# Separate Cloudflare Access token for the remote Ollama endpoint.
OLLAMA-CF-ACCESS-CLIENT-ID=
OLLAMA-CF-ACCESS-CLIENT-SECRET=

# One switch for a whole regression run, not per evaluation. Leave it false to
# score locally without adding experiments to LangSmith. The --upload flag on
# evals.regression.run_priority and run_full does the same thing.
REGRESSION_UPLOAD_TO_LANGSMITH=false

# LangSmith tracing. Off by default; set it to true only when you want traces.
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
