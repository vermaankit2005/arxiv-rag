# Copy this file to .env and fill in the blanks. .env is gitignored.
# Cloudflare Access token for the ChatOpenAI-compatible vLLM endpoint.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Separate Cloudflare Access token for the remote Ollama endpoint.
OLLAMA_CF_ACCESS_CLIENT_ID=
OLLAMA_CF_ACCESS_CLIENT_SECRET=

# Model and reranking providers.
GROQ_API_KEY=
COHERE_API_KEY=

# Remote Weaviate vector database.
WEAVIATE_URL=
WEAVIATE_API_KEY=

# One upload switch for every individual eval and regression suite.
# Leave it false to score without adding experiments to LangSmith.
EVAL_UPLOAD_TO_LANGSMITH=false

# LangSmith tracing. Off by default; set it to true only when you want traces.
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
