# Copy this file to .env and fill in the blanks. .env is gitignored.

# Ollama server that serves the embedding model.
OLLAMA_BASE_URL=

# LangSmith tracing. Leave LANGSMITH_TRACING=false to turn tracing off.
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
